# Supabase (optional -- app works in offline mode without these)
# Create a free project at https://supabase.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only — bypass RLS for indexer back-fill writes. NEVER exposed to client.
SUPABASE_SERVICE_ROLE_KEY=

# WalletConnect Project ID (optional -- for WalletConnect support)
# Create a free project at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=

# AI Agent server keys (server-side only -- /api/agent/derive)
#
# Provider preference order:
#   PRIMARY:   NVIDIA Kimi K2 instruct (NVIDIA_API_KEY)
#   FALLBACK:  Anthropic Claude opus-4-6 (ANTHROPIC_API_KEY)
#
# Set at least ONE of NVIDIA_API_KEY / ANTHROPIC_API_KEY. AGENT_PRIVATE_KEY
# is always required (signs the on-chain attestation).
#
# Override the order via AGENT_PROVIDER_PREFERENCE=anthropic if you want
# Claude tried first instead of Kimi.
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
AGENT_PROVIDER_PREFERENCE=

# AGENT_PRIVATE_KEY: 0x-prefixed 64-char hex; the wallet that signs agent
#                    attestations on-chain. Publish AGENT_ADDRESS publicly
#                    via VITE_AGENT_ATTESTATION_ADDRESS so users can audit.
AGENT_PRIVATE_KEY=

# AA relayer (server-side only -- /api/relay)
# RELAYER_PRIVATE_KEY: 0x-prefixed 64-char hex; the wallet that submits
#                      UserOperations to EntryPoint. Needs ETH on every
#                      supported chain to pay submission gas. Refunded by
#                      the BlankPaymaster in feeToken (TestUSDC) — the
#                      paymaster's own ETH balance covers the gas in the
#                      meantime, refilled by an offline funding loop.
# SEPOLIA_RPC_URL / BASE_SEPOLIA_RPC_URL: per-chain RPC for the relayer
RELAYER_PRIVATE_KEY=
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# Frontend RPC URLs (optional — browser-exposed, prefix VITE_)
#
# Public testnet RPCs aggressively rate-limit under load, which makes the
# wagmi reads (balances, contract state) unreliable. Setting these points
# the frontend at a private RPC (Alchemy/QuickNode/Infura) whose provider
# supports *domain allowlisting* so the URL is safe to bundle into the client.
#
# If unset, the app falls back to a curated list of public RPCs with
# automatic failover (see src/lib/rpc.ts). Recommended for production — a
# single public RPC throttling you should not take the UI down.
VITE_SEPOLIA_RPC_URL=
VITE_BASE_SEPOLIA_RPC_URL=

# Public agent attestation address (frontend-exposed -- prefix VITE_)
# Address derived from AGENT_PRIVATE_KEY. Publish so users can audit which
# agent signed each AI-derived payment. Same value across all chains.
VITE_AGENT_ATTESTATION_ADDRESS=

# Frontend error tracking (optional). When set, Sentry captures errors +
# warnings logged via lib/log. Without it the app still works — logs
# stay in the browser console. Get a DSN at https://sentry.io
VITE_SENTRY_DSN=

# Server-side signer backend. "env" (default) reads keys from env vars.
# "kms" will fetch from AWS KMS — see docs/SIGNER_KMS_PLAN.md.
BLANK_SIGNER_BACKEND=

# When BLANK_SIGNER_BACKEND=kms, both must be set:
KMS_AGENT_KEY_ID=
KMS_RELAYER_KEY_ID=

# Set to any random hex string. Vercel Cron must include it in
# Authorization header; protects /api/cron/* from public abuse.
CRON_SECRET=

# Phase 4.1 — ScheduledSends server-held session-key encryption.
#
# 32-byte hex value used as the AES-256-GCM master key for the
# `session_keys` table. Generate once with:
#   openssl rand -hex 32
#
# CRITICAL: this single secret + DB read access = ability to forge UserOps
# within every stored scope's bounds (maxAmountPerCall + recipient +
# period). Treat it like a production deploy key — Vercel project-level
# env, NOT branch-level. Rotate by re-encrypting every row (see ops
# runbook in api/_lib/session-keys-store.ts header).
#
# When unset: /api/scheduled-sends/create returns 503 and the frontend
# surfaces a "set up not yet available" message instead of silently
# failing.
SESSION_KEYS_MASTER_KEY=

# Phase 5.7 — Signed-oracle fallback for invoice payments. Generates
# ECDSA-signed price quotes that BusinessHub.payInvoiceWithOracleQuote
# verifies on chain. Used for tokens Uniswap doesn't have a pool for.
#
# Setup:
#   1. Generate a fresh secp256k1 keypair (e.g. `cast wallet new`).
#   2. Set ORACLE_PRIVATE_KEY here to the 0x-prefixed 64-char hex private key.
#   3. After running deploy-upgrade-businesshub-v020, call
#      `businessHub.setOracleAttestationAddress(<corresponding pubkey>)`
#      from the contract owner.
#
# Compromise → rotate via setOracleAttestationAddress (immediately
# invalidates every pre-rotation signature). On-chain rate sanity bounds
# (ratePpm ∈ [1, 1e8]) cap downstream damage even with a valid signature.
ORACLE_PRIVATE_KEY=

# Phase 4.1 — SessionKeyValidator addresses per chain. The cron tick
# wraps UserOp signatures with this address so BlankAccount's
# _validateSignature dispatches to the validator. Value comes from
# `pnpm hardhat deploy-session-key-validator` output and matches the
# corresponding entry in src/lib/constants.ts.
VITE_BLANK_11155111_SESSION_KEY_VALIDATOR=
VITE_BLANK_84532_SESSION_KEY_VALIDATOR=

# Paymaster monitor (server-side, /api/cron/paymaster-monitor)
#
# Daily cron reads EntryPoint.balanceOf(BlankPaymaster) on each chain and
# emails an operator if any deposit drops below the threshold.
#
# PAYMASTER_ALERT_EMAIL_TO       — recipient (operator). Unset → cron logs only.
# PAYMASTER_ALERT_THRESHOLD_WEI  — wei value. Default 0.1 ETH (1e17 wei).
#                                  Set well above the client's "unavailable"
#                                  floor (0.01 ETH) so we alert before users
#                                  see degraded banners.
PAYMASTER_ALERT_EMAIL_TO=
PAYMASTER_ALERT_THRESHOLD_WEI=

# ──────────────────────────────────────────────────────────────────────
# Wave 3 — Foundation env vars (Phase 0)
# ──────────────────────────────────────────────────────────────────────

# Optional mainnet RPC for ENS / Basenames lookups. If unset the app falls
# back to a curated list of public mainnet RPCs (publicnode, llamarpc,
# cloudflare-eth). Browser-exposed, so use a domain-allowlisted endpoint.
VITE_MAINNET_RPC_URL=

# Pinata IPFS pinning JWT (server-side). Used to upload invoice PDFs and
# escrow file attachments. Generate at https://pinata.cloud (Account
# Settings → Keys). Use a scoped *upload-only* key.
PINATA_JWT=

# Resend transactional email (server-side). Get an API key at resend.com.
# EMAIL_FROM is the default From header — needs to match a verified domain
# on Resend (e.g. "Blank <invoices@blank.app>").
RESEND_API_KEY=
EMAIL_FROM=

# Web Push (browser notifications when the app is closed).
#
# Generate a fresh keypair once with:
#   npx web-push generate-vapid-keys
#
# VITE_VAPID_PUBLIC_KEY  — shipped to the browser; used by pushManager.subscribe
# VAPID_PUBLIC_KEY       — same value, but visible to api/_lib/web-push.ts
# VAPID_PRIVATE_KEY      — server-only; signs notifications to push services
# VAPID_SUBJECT          — mailto: contact for push provider abuse reports
# PUSH_NOTIFY_SECRET     — random hex; required Bearer token on /api/push/notify
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@blank.app
PUSH_NOTIFY_SECRET=

# ─── Email auth ─────────────────────────────────────────────────────
# /api/email/{invoice,request} verify a wallet signature on the body so
# only the address that owns the invoice / request can trigger an
# outbound email to the client. Default is FAIL-CLOSED — if STRICT_EMAIL_AUTH
# is unset or any value other than "0", the endpoints reject unsigned
# requests. Only set to "0" for local dev when you don't want to sign
# every request. Leave unset in production.
STRICT_EMAIL_AUTH=
