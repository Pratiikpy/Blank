{
  "rewrites": [
    { "source": "/pitchdeck", "destination": "/pitchdeck.html" },
    { "source": "/proof-deck", "destination": "/proof-deck.html" },
    { "source": "/", "has": [{ "type": "host", "value": "docs.myblank.app" }], "destination": "/route-shells/whitepaper.html" },
    { "source": "/", "has": [{ "type": "host", "value": "brand.myblank.app" }], "destination": "/route-shells/brand-kit.html" },
    { "source": "/", "has": [{ "type": "host", "value": "blog.myblank.app" }], "destination": "/route-shells/blog.html" },
    { "source": "/features", "destination": "/route-shells/features.html" },
    { "source": "/how-it-works", "destination": "/route-shells/how-it-works.html" },
    { "source": "/roadmap", "destination": "/route-shells/roadmap.html" },
    { "source": "/live", "destination": "/route-shells/live.html" },
    { "source": "/manifesto", "destination": "/route-shells/manifesto.html" },
    { "source": "/pricing", "destination": "/route-shells/pricing.html" },
    { "source": "/for/individuals", "destination": "/route-shells/for-individuals.html" },
    { "source": "/for/creators", "destination": "/route-shells/for-creators.html" },
    { "source": "/for/businesses", "destination": "/route-shells/for-businesses.html" },
    { "source": "/for/daos", "destination": "/route-shells/for-daos.html" },
    { "source": "/status", "destination": "/route-shells/status.html" },
    { "source": "/whitepaper", "destination": "/route-shells/whitepaper.html" },
    { "source": "/brand-kit", "destination": "/route-shells/brand-kit.html" },
    { "source": "/blog", "destination": "/route-shells/blog.html" },
    { "source": "/blog/why-fhenix-cofhe", "destination": "/route-shells/blog-why-fhenix-cofhe.html" },
    { "source": "/blog/fhe-vs-zk", "destination": "/route-shells/blog-fhe-vs-zk.html" },
    { "source": "/blog/wave-3-shipped", "destination": "/route-shells/blog-wave-3-shipped.html" },
    { "source": "/blog/why-no-token-ever", "destination": "/route-shells/blog-why-no-token-ever.html" },
    { "source": "/v/:proofId", "destination": "/api/share/proof?id=:proofId" },
    { "source": "/api/relayer-health", "destination": "/api/health?kind=relayer" },
    { "source": "/api/reconcile-user", "destination": "/api/cron/reconcile-user" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(), payment=(self)" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https: wss: blob: data:; worker-src 'self' blob: data:; child-src 'self' blob: https:; frame-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reconcile-tick",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/invoice-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/paymaster-monitor",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/paymaster-refill",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/relayer-refill",
      "schedule": "15 12 * * *"
    },
    {
      "path": "/api/cron/scheduled-sends-tick",
      "schedule": "0 0 * * *"
    }
  ]
}
