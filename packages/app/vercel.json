{
  "rewrites": [
    { "source": "/pitchdeck", "destination": "/pitchdeck.html" },
    { "source": "/v/:proofId", "destination": "/api/share/proof?id=:proofId" },
    { "source": "/api/relayer-health", "destination": "/api/health?kind=relayer" },
    { "source": "/api/reconcile-user", "destination": "/api/cron/reconcile-user" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(), payment=(self)" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https: wss: blob: data:; worker-src 'self' blob: data:; child-src 'self' blob: https:; frame-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reconcile-tick",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/invoice-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/paymaster-monitor",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/paymaster-refill",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/relayer-refill",
      "schedule": "15 12 * * *"
    },
    {
      "path": "/api/cron/scheduled-sends-tick",
      "schedule": "0 0 * * *"
    }
  ]
}
